# Configuración research_agent — copia a config/.env y rellena los valores
# NUNCA subir config/.env a git (está en .gitignore)

# Rutas base
RESEARCH_BASE=/Volumes/research
CATEGORIES_BASE=/Volumes/research/categorias

# Ollama (clasificación de PDFs, embeddings)
# Ejecutando en pciq22: clientes LOCALES (pipeline, Streamlit) hablan directo
# con Ollama por loopback, sin token. Un cliente REMOTO debe usar en su lugar
# http://pciq22.uca.es:11434 (proxy Caddy) + cabecera
# "Authorization: Bearer <OLLAMA_API_KEY>" — ver deployment/README.md.
OLLAMA_HOST=http://127.0.0.1:11435
OLLAMA_MODEL=gemma3:4b
# Token del proxy Caddy (reutilizado como bearer token, no como API key de Ollama)
OLLAMA_API_KEY=

# GROBID (solo uso local, sin proxy ni token)
GROBID_URL=http://127.0.0.1:8070
GROBID_TIMEOUT=600

# Elsevier / Unpaywall (descarga de PDFs)
UNPAYWALL_EMAIL=tu_email@uca.es
ELSEVIER_API_KEY=

# LLM providers (síntesis RAG)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Autenticación Streamlit
PRIVATE_APP_PASSWORD=
PUBLIC_APP_PASSWORD=

# Email — ingesta semanal automática (run_weekly_scopus.py)
# Gmail: genera una App Password en myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gm.uca.es
SMTP_PASSWORD=tu_app_password_gmail
SMTP_TO=tu_cuenta@uca.es
