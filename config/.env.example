# Configuración research_agent — copia a config/.env y rellena los valores
# NUNCA subir config/.env a git (está en .gitignore)

# Rutas base
RESEARCH_BASE=/Volumes/research
CATEGORIES_BASE=/Volumes/research/categorias

# Ollama (clasificación de PDFs, embeddings)
OLLAMA_HOST=http://pciq22.uca.es:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_API_KEY=

# GROBID
GROBID_URL=http://pciq22.uca.es:8070
GROBID_TIMEOUT=600

# Elsevier / Unpaywall (descarga de PDFs)
UNPAYWALL_EMAIL=tu_email@uca.es
ELSEVIER_API_KEY=

# LLM providers (síntesis RAG)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Autenticación Streamlit
PRIVATE_APP_PASSWORD=
PUBLIC_APP_PASSWORD=

# Email — ingesta semanal automática (run_weekly_scopus.py)
# Gmail: genera una App Password en myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gm.uca.es
SMTP_PASSWORD=tu_app_password_gmail
SMTP_TO=tu_cuenta@uca.es
