# Copia a config/.env.obsidian y rellena con la API key del plugin
# "Local REST API with MCP" de Obsidian (Settings → Local REST API with MCP →
# API Key). Ver deployment/README.md para más detalle.

OBSIDIAN_API_KEY=

# Opcional — normalmente no hace falta tocarlo (valor por defecto del plugin)
# OBSIDIAN_BASE_URL=https://127.0.0.1:27124

# Opcional — ruta a un certificado CA si en el futuro decides confiar en el
# certificado autofirmado del plugin en vez de desactivar la verificación TLS
# OBSIDIAN_CA_CERT=
