<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.research_agent.healthcheck</string>
    <key>WorkingDirectory</key>
    <string>/Users/martinramirez/proyectos/research_agent/scripts</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/martinramirez/venvs/rag_papers/bin/python3.13</string>
        <string>healthcheck.py</string>
    </array>
    <!-- Cada 10 minutos; solo envía email si cambia el conjunto de fallos -->
