  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.research_agent.caddy_ollama</string>

    <key>WorkingDirectory</key>
    <string>/Users/martinramirez/proyectos/research_agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/caddy</string>
        <string>run</string>
